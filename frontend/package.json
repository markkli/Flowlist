{
  "name": "flowlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5500 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:site": "npm run build -- --mode site",
    "preview": "vite preview --host 127.0.0.1 --port 8010 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cloudflare": "npm run build:site && playwright test --config playwright.cloudflare.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "4.1.11",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  }
}
