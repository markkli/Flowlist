# Copy to .env.beta (ignored by Git). Never put real secrets in this example.
FLOWLIST_DOMAIN=beta.your-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
SUPABASE_SECRET_KEY=sb_secret_replace
# Restricted flowlist_api role: use URL-encoded credentials and TLS.
DATABASE_URL=postgresql+psycopg://flowlist_api:REPLACE@YOUR_DATABASE_HOST:5432/postgres?sslmode=verify-full
# Owner/migration role, used only by the release job.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:REPLACE@YOUR_DATABASE_HOST:5432/postgres?sslmode=verify-full
# Compose supplies the bundled Supabase CA path. For local admin commands, set
# PGSSLROOTCERT to the absolute path of backend/certs/supabase-prod-ca-2021.crt.
FLOWLIST_BETA_SIGNUPS=invite
FLOWLIST_BETA_EMAILS=your-invited-email@example.com
# Enable only after configuring Google's OAuth client and Supabase provider.
FLOWLIST_GOOGLE_LOGIN=false
