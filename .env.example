# Docker Compose deployment settings. Copy this file to .env and change the password.
POSTGRES_USER=flowlist
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=flowlist
FLOWLIST_PORT=8080
WEB_CONCURRENCY=1

# Optional AI features
OPENAI_API_KEY=
OPENAI_SUBTASK_MODEL=gpt-5.4-mini
OPENAI_FOCUS_TITLE_MODEL=gpt-5.4-mini

# Optional, comma-separated browser origins when the API is exposed separately.
FLOWLIST_CORS_ORIGINS=
